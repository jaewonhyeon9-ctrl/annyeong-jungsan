# ============================================================
# 안녕메디컬 정산 — 환경 변수
# ============================================================
# 사용법:
#   1) Supabase에서 새 프로젝트 생성 (https://supabase.com)
#   2) Project Settings → API 에서 URL과 anon key 복사
#   3) 이 파일을 ".env.local" 로 복사하고 값 채워넣기
#   4) Supabase Dashboard > SQL Editor 에서 supabase/schema.sql 실행
# ============================================================

# Supabase — 클라이언트에서 사용 (공개 안전)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase — 서버 전용 (절대 클라이언트로 노출 X)
# 마이그레이션/관리 작업용
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Claude Vision API — Phase 3 OCR용 (선택)
ANTHROPIC_API_KEY=sk-ant-...
